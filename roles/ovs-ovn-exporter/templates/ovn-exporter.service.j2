[Unit]
Description={{ ovn_exporter_description }}
After=network.target
# A database restart makes the exporter exit non-zero, which exhausts the default
# limit of five starts in ten seconds and leaves the unit permanently failed.
# ExecStartPre below waits out a restarting database, so attempts that are merely
# waiting are spaced far enough apart to stay under this window, while an exporter
# that is genuinely broken fails fast and still reaches the failed state.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
User={{ ovn_exporter_user }}
Group={{ ovn_exporter_group }}
EnvironmentFile=-/etc/sysconfig/{{ ovn_exporter_service_name }}
EnvironmentFile=-/etc/default/{{ ovn_exporter_service_name }}
ExecStart={{ exporter_install_dir }}/ovn-exporter $OPTIONS
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target {{ kolla_ovn_nb_container_service }} {{ kolla_ovn_sb_container_service }}
