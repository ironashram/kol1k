# Systemd drop-in override for Kolla container dependencies
# Managed by Ansible - do not edit manually

[Unit]
After=docker.service {{ kolla_ovs_container_service }}
Requires={{ kolla_ovs_container_service }}

[Service]
# The kolla container unit goes active as soon as `docker start -a` runs,
# before ovsdb-server inside opens /var/run/openvswitch/db.sock. Wait up to
# 120s for the socket so the exporter does not race it and trip
# StartLimitBurst at boot.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 120); do [ -S {{ kolla_ovs_socket | replace("unix:", "") }} ] && exit 0; sleep 1; done; exit 1'
