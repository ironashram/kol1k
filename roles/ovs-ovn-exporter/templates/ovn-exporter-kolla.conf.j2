# Systemd drop-in override for Kolla container dependencies
# Managed by Ansible - do not edit manually

[Unit]
# Require OVN database containers
Requires={{ kolla_ovn_nb_container_service }}
Requires={{ kolla_ovn_sb_container_service }}
# Want northd (may run on a different host)
Wants={{ kolla_ovn_northd_container_service }}
After={{ kolla_ovn_nb_container_service }}
After={{ kolla_ovn_sb_container_service }}
After={{ kolla_ovn_northd_container_service }}

[Service]
# Kolla container units go active as soon as `docker start -a` runs, before the
# daemons inside open their sockets. The socket files are bind-mounted from the
# host and survive a container restart, so only an actual connect distinguishes a
# listening database from a stale inode. Waits for NB and SB, plus vswitchd on
# hosts that also run Open vSwitch. Runs as root because the service user reaches
# the sockets through the binary's cap_dac_override, which a probe process does
# not carry.
ExecStartPre=+/bin/sh -c 'for i in $(seq 1 120); do nc -U -z /run/ovn/ovnnb_db.sock && nc -U -z /run/ovn/ovnsb_db.sock{% if inventory_hostname in groups.get("openvswitch", []) %} && nc -U -z /var/run/openvswitch/db.sock{% endif %} && exit 0; sleep 1; done; exit 1'
