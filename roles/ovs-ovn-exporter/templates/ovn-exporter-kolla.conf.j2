# Systemd drop-in override for Kolla container dependencies
# Managed by Ansible - do not edit manually

[Unit]
After=docker.service {{ kolla_ovn_nb_container_service }} {{ kolla_ovn_sb_container_service }} {{ kolla_ovn_northd_container_service }}
Requires={{ kolla_ovn_nb_container_service }} {{ kolla_ovn_sb_container_service }}
Wants={{ kolla_ovn_northd_container_service }}

[Service]
# Kolla container units go active as soon as `docker start -a` runs, before the
# daemons inside open their sockets. Wait up to 120s for the NB and SB sockets
# so the exporter does not race them and trip StartLimitBurst at boot.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 120); do [ -S {{ kolla_ovn_nb_socket | replace("unix:", "") }} ] && [ -S {{ kolla_ovn_sb_socket | replace("unix:", "") }} ] && exit 0; sleep 1; done; exit 1'
